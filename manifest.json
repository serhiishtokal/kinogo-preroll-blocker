{
  "manifest_version": 3,
  "name": "Kinogo Pre-roll Blocker",
  "version": "1.3.0",
  "description": "Blocks known Kinogo player ads, page branding, and AdAngle banners.",
  "minimum_chrome_version": "145",
  "permissions": ["declarativeNetRequest"],
  "content_scripts": [
    {
      "matches": ["https://kinogo.org/*"],
      "css": ["page-ads.css"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "cinemar_ads", "enabled": true, "path": "rules.json" }
    ]
  }
}
